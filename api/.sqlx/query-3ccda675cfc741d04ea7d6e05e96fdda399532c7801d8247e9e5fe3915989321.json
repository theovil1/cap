  "query": "SELECT s.id, s.position, s.name, s.county, s.lat, s.lon, s.at_m, u.unlocked_at AS \"unlocked_at?\"\n         FROM route_stages s\n         LEFT JOIN stage_unlocks u ON u.stage_id = s.id AND u.journey_id = $2 AND u.user_id = $3\n         WHERE s.route_id = $1\n         ORDER BY s.position",
