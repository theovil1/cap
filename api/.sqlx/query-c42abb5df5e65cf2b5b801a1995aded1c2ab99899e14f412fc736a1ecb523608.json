  "query": "SELECT a.journey_id, a.distance_m, p.distance_m AS total_m,\n                (p.arrived_at IS NOT NULL) AS \"arrived!\"\n         FROM session_allocations a\n         JOIN journey_participants p ON p.journey_id = a.journey_id AND p.user_id = $2\n         WHERE a.session_id = $1",
