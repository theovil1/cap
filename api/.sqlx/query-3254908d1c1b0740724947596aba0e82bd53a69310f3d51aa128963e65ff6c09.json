  "query": "SELECT ph.content_type, COALESCE(CASE WHEN $3 THEN ph.thumb END, ph.image) AS \"image!\"\n         FROM public_route_photos ph JOIN public_routes p ON p.id = ph.public_route_id\n         WHERE ph.public_route_id = $1 AND ph.kind = $2 AND NOT p.hidden",
