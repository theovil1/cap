# Local development (cargo run). In Docker, infra/compose.yaml sets these.
DATABASE_URL=postgres://cap:change-me@127.0.0.1:5432/cap
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-change-me-change-me-change-me
APPLE_BUNDLE_ID=io.github.theovil1.cap
GRAPHHOPPER_URL=http://127.0.0.1:8989
PHOTON_URL=http://127.0.0.1:2322
BIND_ADDR=127.0.0.1:8080
BEHIND_PROXY=false
RUST_LOG=info,tower_http=info
