# Copy to infra/.env and change every value.
POSTGRES_PASSWORD=change-me
# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-change-me-change-me-change-me
APPLE_BUNDLE_ID=io.github.theovil1.cap

# Host port of PostgreSQL (127.0.0.1 only)
DB_PORT=5432
# Where the API listens on the host. Keep 127.0.0.1 behind a reverse proxy.
API_BIND=127.0.0.1
API_PORT=8080
# true when a reverse proxy sets X-Forwarded-For (used for rate limiting)
BEHIND_PROXY=false

# Java heap sizes. Importing France in GraphHopper needs about 8 GB.
GRAPHHOPPER_HEAP=8g
PHOTON_HEAP=2g
# RAM_STORE (fast, needs RAM) or MMAP (small heap, for servers with little memory)
GRAPHHOPPER_STORAGE=RAM_STORE
