// Safe walking profile for Cap: based on GraphHopper's foot.json.
// Motorways and expressways are excluded, busy roads are strongly penalised, and
// foot_priority already favours footways, paths, cycleways, residential streets
// and roads tagged with a sidewalk. Penalties (not bans) keep a route available
// in the countryside, where sidewalk data is incomplete.
{
  "priority": [
    { "if": "!foot_access || hike_rating >= 2", "multiply_by": "0" },
    { "else": "", "multiply_by": "foot_priority" },
    { "if": "road_class == MOTORWAY || road_class == TRUNK", "multiply_by": "0" },
    { "else_if": "road_class == PRIMARY", "multiply_by": "0.1" },
    { "else_if": "road_class == SECONDARY", "multiply_by": "0.35" },
    { "else_if": "road_class == TERTIARY", "multiply_by": "0.7" },
    { "if": "foot_road_access == PRIVATE", "multiply_by": "0.1" }
  ],
  "speed": [
    { "if": "true", "limit_to": "foot_average_speed" }
  ],
  "distance_influence": 30
}
